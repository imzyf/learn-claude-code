# s17 环境变量的默认值参考，程序不加载这份文件。
# 要改某一项：在命令行内联，只对这一次运行生效，见 README.md。

# 判断器用的模型（evaluatorModelId）：先读这个，没设退到
# ANTHROPIC_DEFAULT_HAIKU_MODEL，再没有就和主模型 MODEL_ID 同一个。
# 两个都默认不设置。
# GOAL_EVALUATOR_MODEL_ID=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=

# Stop hook 连续阻止多少轮之后停下（DEFAULT_STOP_HOOK_BLOCK_CAP）。
CLAUDE_CODE_STOP_HOOK_BLOCK_CAP=8
# 主循环的总轮数上限。0 或非整数、非正数都表示不限轮数。
MAX_TURNS=0
