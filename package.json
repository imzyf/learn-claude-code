{
  "name": "learn-claude-code",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript port of learn-claude-code, built on @anthropic-ai/sdk",
  "type": "module",
  "scripts": {
    "dev": "env -u ANTHROPIC_AUTH_TOKEN tsx --env-file-if-exists=.env",
    "smoke": "env -u ANTHROPIC_AUTH_TOKEN tsx --env-file-if-exists=.env lib/smoke.ts",
    "typecheck": "tsc --noEmit",
    "fmt:check": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "croner": "^11.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.16.1"
}
