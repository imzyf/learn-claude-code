# s08 压缩流水线十个阈值的默认值参考，程序不加载这份文件。
# 要改某一层：在命令行内联，只对这一次运行生效，见 README.md。

# L1 裁剪阈值：消息数超过它就裁掉中间部分（每轮都跑）
L1_COMPACT_SNIP_MAX_MESSAGES=50
# L1 裁剪时保留的头部消息数（尾部保留数 = maxMessages - 头部 - 1，少的那条留给存档标记）
L1_COMPACT_SNIP_KEEP_HEAD=3

# L2 保留最近 N 条模型已经看过的工具结果不动，只压缩更早的（仅在上下文超限时跑）
L2_COMPACT_KEEP_RECENT=3
# L2 微压缩阈值：单条工具结果短于它就不值得压缩
L2_COMPACT_MICRO_MIN_LENGTH=120

# L3 预算：最新一轮 tool_result 总量超过它才开始落盘（每轮都跑）
L3_COMPACT_TOOL_RESULT_BUDGET=200000
# L3 落盘阈值：单条工具结果超过该长度才值得写到磁盘（预览长度 = 该值的十分之一）
L3_COMPACT_PERSIST_THRESHOLD=30000

# L3b 预览长度：被换掉的结果在消息里留多少字（默认比 L3 的 3000 短）
L3B_COMPACT_FIT_PREVIEW_LENGTH=1000

# L4 触发阈值：估算大小（JSON 字符数，不是 token）超过它才进 L2 -> L3b -> L4 这三层
L4_COMPACT_CONTEXT_LIMIT=50000
# L2/L3b 的停手点，写成上面那个阈值的比例：压到这里就不再往前压
# 调到 0.99 能看清「够了就停」，调到 0.1 能看清一路压到底
L4_COMPACT_TARGET_RATIO=0.8
# L4 摘要输入上限：喂给摘要子请求的历史 JSON 超过它就掐头去尾
L4_COMPACT_SUMMARY_INPUT_LIMIT=80000
